# PostgreSQL 异步连接串；PRD 未指定默认，以下为本地开发示例
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_drama_studio

# 媒体数据根目录；PRD 未指定默认，以下为仓库内本地目录
DATA_DIR=./data

# vLLM OpenAI 兼容服务地址；PRD 未指定默认，以下为本地开发示例
VLLM_BASE_URL=http://localhost:8001

# vLLM 模型 ID；PRD 仅指定 Qwen，以下为示例值，须与实际服务模型一致
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# ComfyUI 服务地址；PRD 未指定默认，以下采用 ComfyUI 常用本地端口
COMFY_BASE_URL=http://localhost:8188

# 单集剧本最大字符数
SCRIPT_CHAR_LIMIT=2000

# 单片段最大请求时长（秒，硬限制）
CLIP_MAX_SECONDS=15

# 单片段建议最小时长（秒，低于此值仅软提醒）
CLIP_MIN_SECONDS=5

# 参考资产槽位硬上限
SLOT_HARD_LIMIT=9

# 参考资产槽位软提示阈值
SLOT_SOFT_LIMIT=4

# 单个上传文件最大体积（MB）
UPLOAD_MAX_MB=20

# trash 内容保留时长（小时）
TRASH_RETENTION_HOURS=24

# 是否在详情 API 暴露 built_prompt 与 input_snapshot
DEBUG_PROMPTS=false

# PRD §8 的 ComfyUI 工作流与节点绑定使用 TOML 绑定表，不属于环境变量；由相应 change 在外部文件到位后创建。

